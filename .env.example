# SecureVault Production Deployment Environment Variables
# Copy this file to '.env' and populate with production credentials before running docker-compose.

# Database Configuration
POSTGRES_DB=password_vault
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_production_password_here
POSTGRES_PORT=5432

# Backend Security Configuration
APP_JWT_SECRET=your_long_random_jwt_secret_64_characters_min
APP_JWT_EXPIRATION_MS=86400000

# SMTP / Email Configuration
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_smtp_app_password

# Container Port Bindings
FRONTEND_PORT=80
BACKEND_PORT=8080
